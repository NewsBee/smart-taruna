# Database production.
# Untuk Cloud Run + Cloud SQL MySQL via Unix socket:
# mysql://DB_USER:DB_PASSWORD@localhost/DB_NAME?socket=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DATABASE_URL=

# URL publik aplikasi. Untuk lokal gunakan http://localhost:3000;
# untuk production gunakan domain HTTPS aplikasi.
NEXTAUTH_URL=

# Secret acak untuk NextAuth.
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth untuk fitur login/daftar dengan Google.
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upload lokal: kosong = data/uploads di dalam folder proyek.
LOCAL_UPLOAD_DIR=

# Pemeriksaan sesi kedaluwarsa setiap 15 detik pada server Node.
EXAM_SWEEPER_ENABLED=true

# Batas total jeda koneksi terputus per sesi ujian, dalam menit (0-1440).
EXAM_MAX_OFFLINE_PAUSE_MINUTES=5
