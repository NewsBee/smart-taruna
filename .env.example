# Database production.
# Untuk Cloud Run + Cloud SQL MySQL via Unix socket:
# mysql://DB_USER:DB_PASSWORD@localhost/DB_NAME?socket=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DATABASE_URL=

# URL publik aplikasi production.
# Setelah deploy pertama, ambil dari Cloud Run service URL, contoh:
# https://smart-taruna-xxxxx-et.a.run.app
NEXTAUTH_URL=

# Secret acak untuk NextAuth.
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth untuk fitur login/daftar dengan Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Storage untuk upload foto profil, gambar soal, dan gambar pembahasan.
# Isi dengan nama bucket, contoh: smart-taruna-assets
GCS_BUCKET_NAME=

# Opsional. Isi jika bucket memakai custom domain/CDN.
# Jika kosong, URL default: https://storage.googleapis.com/GCS_BUCKET_NAME/path-file
GCS_PUBLIC_BASE_URL=
